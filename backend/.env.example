# Project 
PROJECT_NAME="FHIR Verity"
PROJECT_DESCRIPTION="Server-wide data quality validation for FHIR servers"
PROJECT_VERSION="1.0.0"


# Database
DATABASE_URL=postgresql+asyncpg://your_user:your_password@your_db:PORT/db
POSTGRES_DB=your_postgre_db

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development          # development | production


# Encryption at rest (FHIR server credentials)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=####

# Auth
# false = local development without Keycloak: every request runs as the
# built-in admin "dev" and the Keycloak values below may stay empty.
# Refused with ENVIRONMENT=production.
AUTH_ENABLED=true
SESSION_SECRET_KEY=####
KEYCLOAK_CLIENT_SECRET=#######
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
KEYCLOAK_DISCOVERY_URL=your-keycloak/.well-known/openid-configuration
KEYCLOAK_CLIENT_ID=your-fhir-client
INITIAL_ADMIN_USERS= # comma-separated usernames/emails that become admin on first login

# FHIR reports: publisher name. The canonical base for TestScript.url,
# identifier systems and extensions defaults to the project URL; override
# VERITY_CANONICAL_BASE only with an address that stays valid.
FHIR_REPORT_PUBLISHER="FHIR Verity"
# VERITY_CANONICAL_BASE=https://github.com/DIZ-Giessen/fhir-verity


# Email 
EMAIL_USE_SSL=False
EMAIL_HOST=smtp#####
EMAIL_HOST_PORT=465
EMAIL_ADDRESS= # sender address
EMAIL_USER= # SMTP login
EMAIL_PASSWORD= # SMTP password
EMAIL_VERIFY_CERT=True # set to False only for internal servers with self-signed certificates 