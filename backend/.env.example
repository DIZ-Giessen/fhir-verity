# Project 
PROJECT_NAME="FHIR Verity"
PROJECT_DESCRIPTION="Intelligentes FHIR-Datenqualitäts-Tool für das DIZ Gießen"
PROJECT_VERSION="1.0.0"


# Database
DATABASE_URL=postgresql+asyncpg://your_user:your_password@your_db:PORT/db
POSTGRES_DB=your_postgre_db

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development          # development | production

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api


EXAMPLE_FHIR_BASE_URL= # for your first fhir server
PYTHONPATH=./backend



# Auth
AUTH_ENABLED=true
SESSION_SECRET_KEY=####
KEYCLOAK_CLIENT_SECRET=#######
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
KEYCLOAK_DISCOVERY_URL=your-keycloak/.well-known/openid-configuration
KEYCLOAK_CLIENT_ID=your-fhir-client
INITIAL_ADMIN_USERS= # your initial email who be administrate admin role


# Email 
EMAIL_USE_SSL=False
EMAIL_HOST=smtp#####
EMAIL_HOST_PORT=465
EMAIL_ADDRESS= # email who provider email 
EMAIL_USER= # user email 
EMAIL_PASSWORD= # password 
EMAIL_VERIFY_CERT=False # its should be true when you want that the Cert be checked 