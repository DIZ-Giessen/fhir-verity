# --- Deployment ---
# Muss exakt dem Ordnernamen unter /etc/letsencrypt/live/ entsprechen -
# Caddy nutzt DOMAIN sowohl als Site-Adresse als auch im TLS-Zertifikatspfad.
DOMAIN=localhost                 # Prod: verity.dein-standort.de

# --- Database: einen der beiden Wege wählen (siehe docker-compose.yml) ---
# Weg A - externe PostgreSQL (Standard): nur DATABASE_URL auf den eigenen Host setzen.
DATABASE_URL=postgresql+asyncpg://verity:change_me@db-host.example.org:5432/verity

# Weg B - mitgelieferter Postgres-Container: db-Service in docker-compose.yml
# einkommentieren, diese drei Werte setzen und DATABASE_URL auf Host "db" stellen.
# Passwort und Benutzer müssen in beiden Zeilen identisch sein.
# POSTGRES_USER=verity
# POSTGRES_PASSWORD=change_me
# POSTGRES_DB=verity
# DATABASE_URL=postgresql+asyncpg://verity:change_me@db:5432/verity

# --- App ---
PROJECT_NAME="FHIR Verity"
ENVIRONMENT=production           # Prod: production (setzt Secure-Cookie)
CORS_ORIGINS=https://verity.dein-standort.de

# --- Encryption at rest (FHIR-Server-Zugangsdaten) ---
# Generieren mit: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WICHTIG: sicher aufbewahren - ohne diesen Key sind alle verschlüsselten
# FHIR-Server-Zugangsdaten unwiederbringlich verloren.
FIELD_ENCRYPTION_KEY=change_me_generated_fernet_key

# --- Auth (BFF) ---
AUTH_ENABLED=true
SESSION_SECRET_KEY=change_me_random_64_chars
BACKEND_BASE_URL=https://verity.dein-standort.de
FRONTEND_BASE_URL=https://verity.dein-standort.de
KEYCLOAK_DISCOVERY_URL=https://dein-keycloak/realms/REALM/.well-known/openid-configuration
KEYCLOAK_CLIENT_ID=fhir-verity
KEYCLOAK_CLIENT_SECRET=change_me
INITIAL_ADMIN_USERS=admin@dein-standort.de

# --- FHIR reports (TestScript / TestReport / VerificationResult) ---
# Name, der in jedem Report als Herausgeber/Tester erscheint.
FHIR_REPORT_PUBLISHER="FHIR Verity - DIZ Musterstadt"
# Kanonische Basis-URL für Identifier und Extensions der Reports. Einmal
# festlegen und danach nicht mehr ändern. Leer = aus BACKEND_BASE_URL abgeleitet.
FHIR_REPORT_NAMING_SYSTEM=https://verity.dein-standort.de/fhir/NamingSystem/verity

# --- Email ---
EMAIL_USE_SSL=False
EMAIL_HOST=smtp.dein-standort.de
EMAIL_HOST_PORT=465
EMAIL_ADDRESS=diz-noreply@dein-standort.de
EMAIL_USER=change_me
EMAIL_PASSWORD=change_me
EMAIL_VERIFY_CERT=False