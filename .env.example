# =================================================== Deployment ========================================================





# Caddy nutzt DOMAIN sowohl als Site-Adresse als auch im TLS-Zertifikatspfad.
DOMAIN=localhost  # in Production: verity.dein-standort.de
#CADDY_TLS=internal wenn DOMAIN=localhost







# =================================================== Database: einen der beiden Optionen wählen ========================================================

# FHIR Verity benötigt eine PostgreSQL-Datenbank wo sie ihre eigenen Daten speichern wird (siehe /documentation/datenbank.md). Es gibt zwei Optionen:


# Option A - externe PostgreSQL (Standard): nur DATABASE_URL auf den eigenen Host setzen.
DATABASE_URL=postgresql+asyncpg://verity:change_me@db-host.example.org:5432/verity



# Option B - mitgelieferter Postgres-Container: db-Service in docker-compose.yml
# einkommentieren wenn Option B gewählt wird und DATABASE_URL von Option A auskommentieren.

# POSTGRES_USER=verity
# POSTGRES_PASSWORD=change_me
# POSTGRES_DB=verity
# DATABASE_URL=postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB> USER und PASSWORD müssen mit den oben genannten übereinstimmen. 




# =================================================== App ========================================================



PROJECT_NAME="FHIR Verity"
ENVIRONMENT=production     # Prod: production (setzt Secure-Cookie)
CORS_ORIGINS=              # ZB:https://verity.dein-standort.de 







# =================================================== Encryption at rest ===========================================================




# WICHTIG: sicher aufbewahren - ohne diesen Key sind alle verschlüsselten FHIR-Server-Zugangsdaten unwiederbringlich verloren.
FIELD_ENCRYPTION_KEY=change_me_generated_fernet_key # Generieren mit z.B. python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"








# =================================================== Auth (BFF) ===========================================================



# Im Betrieb immer true. false (ohne Keycloak, alle arbeiten als Admin "dev") ist nur mit ENVIRONMENT=development erlaubt, das Backend startet sonst nicht. (siehe /documentation/deployment.md)
AUTH_ENABLED=true
SESSION_SECRET_KEY=change_me_random_64_chars # Generieren mit z.B. in terminal openssl rand -hex 32
BACKEND_BASE_URL=    # ZB:  https://verity.dein-standort.de
FRONTEND_BASE_URL=    # ZB:  https://verity.dein-standort.de



# =================================================== Keycloak ===========================================================

# FHIR Verity benötigt einen Keycloak Client um die Authentifizierung zu handhaben. 
# Sie können einen der beiden Optionen wählen (siehe documentation/deployment.md)



# Option 1 - eigener Keycloak des Standorts (Standard):
KEYCLOAK_CLIENT_ID=fhir-verity
KEYCLOAK_CLIENT_SECRET=change_me
KEYCLOAK_DISCOVERY_URL=https://dein-keycloak/realms/REALM/.well-known/openid-configuration
INITIAL_ADMIN_USERS=admin@dein-standort.de #Die Email Adresse der User der als Initial Admin gelten wird. (siehe documentation/rollenverwaltung.md)



# Option 2 - mitgelieferter Keycloak (docker-compose.keycloak.yml): die folgenden Zeilen einkommentieren und die Zeilen von Option 1 auskommentieren. (siehe documentation/deployment.md für mehrere Informationen)
# Keycloak läuft dann unter https://<DOMAIN>/kc mit Realm "verity".
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.keycloak.yml
# KEYCLOAK_DISCOVERY_URL=http://keycloak:8080/kc/realms/verity/.well-known/openid-configuration
# INITIAL_ADMIN_USERS=verity-admin
# KEYCLOAK_DB_PASSWORD=change_me            # Datenbank des Keycloak-Containers
# KEYCLOAK_ADMIN_PASSWORD=change_me         # Admin-Konsole /kc/admin, Benutzer "admin"
# VERITY_ADMIN_EMAIL=admin@dein-standort.de # erster Verity-Benutzer "verity-admin"
# VERITY_ADMIN_PASSWORD=change_me           # Startpasswort, beim ersten Login
# KEYCLOAK_CLIENT_ID=fhir-verity
# KEYCLOAK_CLIENT_SECRET=change_me geneirieren, wird in der Keycloak container übernommen 



# ==================================================== FHIR reports (TestScript / TestReport / List) ============================================================


# Name, der in jedem Report als Herausgeber/Tester erscheint.
FHIR_REPORT_PUBLISHER="FHIR Verity - DIZ Musterstadt"


# Kanonische Basis für TestScript.url, Identifier-Systeme und Extension-URLs.
# Standard ist die Projekt-URL; nur überschreiben, wenn ein Standort eine
# eigene, dauerhaft gültige Adresse verwenden will. Danach nicht mehr ändern.
# VERITY_CANONICAL_BASE=https://github.com/fhir-verity/fhir-verity




# ============================================================ Email ==================================================================================================
# Werte angeben fals benachrichtigt werden soll wenn Fehler bei der Validierung auftreten oder nach Erfolg

EMAIL_USE_SSL=#False
EMAIL_HOST=#smtp.dein-standort.de
EMAIL_HOST_PORT=465
EMAIL_ADDRESS=#diz-noreply@dein-standort.de
EMAIL_USER=#change_me
EMAIL_PASSWORD=#change_me
EMAIL_VERIFY_CERT=#False