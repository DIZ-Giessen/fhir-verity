# --- Deployment ---

DOMAIN=localhost  # Sollte es local sein, dann localhost, sonst Prod: verity.dein-standort.de
# Nur lokal ohne Let's-Encrypt-Zertifikat: Caddy stellt selbst ein Zertifikat aus.
# CADDY_TLS=internal #einkommentieren wenn lokal ohne ist.
#
#
#
#
# -------------------------- Database: einen der beiden Wege wählen (siehe docker-compose.yml) ------------------------------------
#
#
# Weg A - externe PostgreSQL (Standard): nur DATABASE_URL auf den eigenen Host setzen.
DATABASE_URL=postgresql+asyncpg://verity:change_me@db-host.example.org:5432/verity

# Weg B - mitgelieferter Postgres-Container: db-Service in docker-compose.yml
# einkommentieren, diese drei Werte setzen und DATABASE_URL auf Host "db" stellen.
# Passwort und Benutzer müssen in beiden Zeilen identisch sein.
# POSTGRES_USER=verity
# POSTGRES_PASSWORD=change_me
# POSTGRES_DB=verity
# DATABASE_URL=postgresql+asyncpg://verity:change_me@db:5432/verity
#
#
#
#
#
# --- App ---
PROJECT_NAME="FHIR Verity"
ENVIRONMENT=production           # Prod: production (setzt Secure-Cookie)
CORS_ORIGINS=https://verity.dein-standort.de
#
#
#
# ----------------------------------- Encryption at rest (FHIR-Server-Zugangsdaten) ------------------------------------------------
# Generieren mit: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WICHTIG: sicher aufbewahren - ohne diesen Key sind alle verschlüsselten FHIR-Server-Zugangsdaten unwiederbringlich verloren.
FIELD_ENCRYPTION_KEY=change_me_generated_fernet_key
#
#
#
#
# ------------------------------------------- Auth (BFF) --------------------------------------------------------------------
# Im Betrieb immer true. false (ohne Keycloak, alle arbeiten als Admin "dev")
# ist nur mit ENVIRONMENT=development erlaubt, das Backend startet sonst nicht.
AUTH_ENABLED=true
SESSION_SECRET_KEY=change_me_random_64_chars
BACKEND_BASE_URL= #Sollte es local sein, dann localhost, sonst Prod: zb. https://verity.dein-standort.de
FRONTEND_BASE_URL= #Sollte es local sein, dann localhost, sonst Prod: zb. https://verity.dein-standort.de
KEYCLOAK_CLIENT_ID=fhir-verity
KEYCLOAK_CLIENT_SECRET=change_me # generien
#
#
#
#
#
# Keycloak: einen der beiden Wege wählen (siehe documentation/deployment.md)
# Weg 1 - eigener Keycloak des Standorts (Standard):
KEYCLOAK_DISCOVERY_URL=https://dein-keycloak/realms/REALM/.well-known/openid-configuration
INITIAL_ADMIN_USERS=user@dein-standort.de

# Weg 2 - mitgelieferter Keycloak (docker-compose.keycloak.yml): die folgenden Zeilen einkommentieren wenn Sie keinen eigenen Keycloak haben und die beiden Zeilen von Weg 1 auskommentieren.
# Keycloak läuft dann unter https://<DOMAIN>/kc mit Realm "verity" und der Client-ID "fhir-verity" user ist admin und password ist password.
#
#
#
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.keycloak.yml
# KEYCLOAK_DISCOVERY_URL=http://keycloak:8080/kc/realms/verity/.well-known/openid-configuration
# INITIAL_ADMIN_USERS=verity-admin
# KEYCLOAK_DB_PASSWORD=change_me            # Datenbank des Keycloak-Containers
# KEYCLOAK_ADMIN_PASSWORD=password         # Admin-Konsole /kc/admin, Benutzer "admin"
# VERITY_ADMIN_EMAIL=admin@dein-standort.de # erster Verity-Benutzer "verity-admin"
# VERITY_ADMIN_PASSWORD=change_me           # Startpasswort, beim ersten Login zu ändern
#
#
#
#
#
#
#
#

# ----------------------------------- FHIR reports (TestScript / TestReport / VerificationResult) ------------------------------------
# Name, der in jedem Report als Herausgeber/Tester erscheint.
FHIR_REPORT_PUBLISHER="FHIR Verity - DIZ Musterstadt"
# Kanonische Basis-URL für Identifier und Extensions der Reports. Einmal
#Leer = aus BACKEND_BASE_URL abgeleitet.
FHIR_REPORT_NAMING_SYSTEM= #zb. https://verity.dein-standort.de/fhir/NamingSystem/verity
#
#
#
#
#
#
#
#
#
#
# ------------------------------------------- Email --------------------------------------------------------------------
#Für Benachrichtigung über Fehler, Warnungen oder Erfolge nach der Valdierung.
#
EMAIL_USE_SSL=False
EMAIL_HOST= #zb. smtp.dein-standort.de
EMAIL_HOST_PORT=465
EMAIL_ADDRESS= #zb. diz-noreply@dein-standort.de
EMAIL_USER= #zb. change_me
EMAIL_PASSWORD= #zb. change_me
EMAIL_VERIFY_CERT=False